<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
  <FileVersion major="1" minor="6" />
  <Project>
    <Option title="Labo2_Demineur" />
    <Option compiler="gcc" />
    <Build>
      <Target title="Debug">
        <Option output="bin/Debug/Labo2_Demineur" prefix_auto="1" extension_auto="1" />
        <Option object_output="obj/Debug/" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Compiler><Add option="-Wall" /><Add option="-Wextra" /><Add option="-std=c11" /></Compiler>
      </Target>
      <Target title="Release">
        <Option output="bin/Release/Labo2_Demineur" prefix_auto="1" extension_auto="1" />
        <Option object_output="obj/Release/" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Compiler><Add option="-Wall" /><Add option="-Wextra" /><Add option="-std=c11" /><Add option="-O2" /></Compiler>
      </Target>
    </Build>
    <Unit filename="main.c"><Option compilerVar="CC" /></Unit>
    <Unit filename="demineur.c"><Option compilerVar="CC" /></Unit>
    <Unit filename="demineur.h"><Option compilerVar="CC" /></Unit>
    <Extensions><code_completion /><debugger /></Extensions>
  </Project>
</CodeBlocks_project_file>
