<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="Codebreaker" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Debug">
                <Option output="bin/Debug/Codebreaker" />
                <Option object_output="obj/Debug/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-g" />
                    <Add option="-Wall" />
                    <Add option="-Wextra" />
                    <Add option="-std=c99" />
                </Compiler>
            </Target>
            <Target title="Release">
                <Option output="bin/Release/Codebreaker" />
                <Option object_output="obj/Release/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-O2" />
                    <Add option="-Wall" />
                    <Add option="-Wextra" />
                    <Add option="-std=c99" />
                </Compiler>
            </Target>
        </Build>
        <Unit filename="main.c">
            <Option compilerVar="CC" />
        </Unit>
        <Unit filename="code.c">
            <Option compilerVar="CC" />
        </Unit>
        <Unit filename="jeu.c">
            <Option compilerVar="CC" />
        </Unit>
        <Extensions />
    </Project>
</CodeBlocks_project_file>
